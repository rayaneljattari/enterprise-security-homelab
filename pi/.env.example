# Copy to .env (never commit .env)
PIHOLE_PASSWORD=change-me
PI_IP=192.168.1.50
# Your public IP or a dynamic DNS name, for VPN clients
WG_HOST=yourname.duckdns.org
# Generate: docker run --rm ghcr.io/wg-easy/wg-easy:14 wgpw 'YourPassword'
# Paste the hash and replace every $ with $$
WG_PASSWORD_HASH=
